# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap, OG and JSON-LD.
# [TODO] Set this in Vercel once your custom domain is connected.
NEXT_PUBLIC_SITE_URL=https://your-domain.com


# --- Optional "Ask about Steve" chat (off unless both are set) ---
# Server-side only. Never prefix with NEXT_PUBLIC_.
ASK_ENABLED=true 
ANTHROPIC_API_KEY=
# Optional tuning:
# ASK_MODEL=claude-opus-5-5
# ASK_RATE_LIMIT=10      # questions per visitor per 10 minutes
# ASK_DAILY_CAP=300      # questions per day per server instance
